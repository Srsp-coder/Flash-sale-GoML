# Copy to .env before `docker compose up --build`.
POSTGRES_PASSWORD=flashsale_secret
RABBITMQ_PASSWORD=flashsale_secret
WEB_PORT=8081
INITIAL_STOCK=500
LOG_LEVEL=info

# Checkout limits. The defaults are deliberately permissive for the 1,000-request
# concurrency verification; lower them for a real public deployment.
RATE_LIMIT_MAX=20000
CHECKOUT_RATE_LIMIT_MAX=20000

RESERVATION_TTL_SECONDS=600
WORKER_PREFETCH=20
WORKER_PROCESSING_DELAY_MS=350
