{
  "name": "flashsale-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker-entry.ts",
    "dev:outbox": "tsx watch src/outbox-entry.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker-entry.js",
    "start:outbox": "node dist/outbox-entry.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "reset:inventory": "tsx src/scripts/reset-inventory.ts",
    "reset:inventory:force": "tsx src/scripts/reset-inventory.ts --yes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "tsx tests/helpers/setup-test-db.ts",
    "test:concurrency": "tsx tests/concurrency/flash-sale-concurrency.ts"
  },
  "dependencies": {
    "@prisma/client": "6.3.1",
    "amqplib": "0.10.5",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-async-errors": "^3.1.0",
    "express-rate-limit": "7.5.0",
    "ioredis": "5.4.2",
    "prisma": "6.3.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "pg": "8.13.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
