# Copy to backend/.env for local development. Values shown are safe local defaults.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://flashsale:flashsale_secret@localhost:5432/flashsale_local?schema=public
REDIS_URL=redis://localhost:6379/2
RABBITMQ_URL=amqp://flashsale:flashsale_secret@localhost:5672
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_MANAGEMENT_USER=flashsale
RABBITMQ_MANAGEMENT_PASSWORD=flashsale_secret

QUEUE_PREFIX=flashsale_app
REDIS_KEY_PREFIX=flashsale_app
INITIAL_STOCK=500
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=2000
CHECKOUT_RATE_LIMIT_MAX=1500
RATE_LIMIT_DISABLED=false

REQUEST_BODY_LIMIT=64kb
RESERVATION_TTL_SECONDS=600
REDIS_ORPHAN_GRACE_SECONDS=120
WORKER_PREFETCH=20
WORKER_PROCESSING_DELAY_MS=350
WORKER_MAX_ATTEMPTS=6
WORKER_RETRY_BASE_MS=2000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_MAX_BACKOFF_MS=60000
RECOVERY_INTERVAL_MS=10000
RECENT_ORDER_LIMIT=12
